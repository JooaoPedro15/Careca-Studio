# Copie este arquivo para .env e preencha com suas credenciais reais.
# .env é ignorado pelo git — nunca commite chaves.

# Gemini API (Google AI Studio)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# YouTube Data API v3 (opcional — Media Kit puxa métricas se presente)
# Console: https://console.cloud.google.com/apis
YOUTUBE_API_KEY=cole_sua_chave_aqui
